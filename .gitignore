# Things vim-plug fetches or generates — never commit these.
# Committing them is what left 35 broken submodule gitlinks in this repo's
# history, which made :PlugInstall silently skip every plugin.
.vim/plugged/
.vim/autoload/plug.vim
.nvim/
nvim/plugged/
nvim/autoload/plug.vim

# Machine-local, generated by install.sh
.vim/local.vim

# Vim runtime state
.vim/.netrwhist
.vim/view/
.vim/swap/
.vim/backup/
.vim/undo/
.vim/spell/
*.swp
*.swo
*~

# install.sh backups
*.backup.*

# OS noise
.DS_Store
